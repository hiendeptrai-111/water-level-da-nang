# Địa chỉ backend Django mà Vite dev server chuyển tiếp /api tới
VITE_BACKEND_URL=http://localhost:8000
# Gốc API mà trình duyệt gọi (để /api khi dùng proxy của Vite)
VITE_API_BASE=/api
# Trang quản trị Django (xem nhật ký, sửa cấu hình)
VITE_DJANGO_ADMIN_URL=http://localhost:8000/django-admin/

# Lớp nền bản đồ, mỗi chế độ một kiểu. Mặc định: Stadia Maps "Alidade Smooth" / "Alidade Smooth Dark"
# (dữ liệu OpenStreetMap). Chính sách: https://docs.stadiamaps.com/authentication/ và
# https://stadiamaps.com/terms-of-service/ – chạy trên localhost không cần khoá; khi đưa lên tên miền
# thật phải tạo tài khoản (gói miễn phí cho phi thương mại) và khai báo tên miền, hoặc thêm
# ?api_key=... vào URL. Phải giữ dòng công nhận nguồn bên dưới. Đổi nhà cung cấp thì đổi cả URL và
# dòng công nhận theo yêu cầu của họ.
VITE_MAP_TILE_URL_LIGHT=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_URL_DARK=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
