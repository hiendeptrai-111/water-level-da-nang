# Sao chép thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Postgres.app, PostgreSQL 18)
DB_NAME=water_level
DB_USER=water
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Địa chỉ frontend (CORS và đường dẫn trong email)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email: mặc định in ra terminal. Dùng SMTP thì bỏ chú thích các dòng dưới.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Canh bao lu Da Nang <no-reply@localhost>

# Giới hạn tần suất (theo địa chỉ IP)
THROTTLE_REGISTER=10/hour
THROTTLE_LOGIN=30/minute
THROTTLE_PASSWORD_FORGOT=5/hour
THROTTLE_RESEND_VERIFICATION=5/hour
